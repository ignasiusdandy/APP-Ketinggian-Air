<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F9FAFB">

    <!-- Header & Filters -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:elevation="4dp"
        android:paddingTop="48dp"
        android:paddingBottom="12dp">
        
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Laporan Pengguna"
            android:textColor="#111827"
            android:textSize="20sp"
            android:layout_marginHorizontal="16dp"
            android:fontFamily="@font/poppinssemibold"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp">
            
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                
                <TextView
                    android:id="@+id/chipSemua"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Semua"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="8dp"
                    android:background="@drawable/bg_chip_active"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppinssemibold"
                    android:clickable="true"
                    android:focusable="true"/>
                    

                <TextView
                    android:id="@+id/chipDiproses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Diproses"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:textColor="#6B7280"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppinssemibold"
                    android:clickable="true"
                    android:focusable="true"/>
                    
                <TextView
                    android:id="@+id/chipDiterima"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Diterima"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:textColor="#6B7280"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppinssemibold"
                    android:clickable="true"
                    android:focusable="true"/>
                    
                <TextView
                    android:id="@+id/chipDitolak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ditolak"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:textColor="#6B7280"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppinssemibold"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSemuaRiwayat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:clipToPadding="false"/>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
