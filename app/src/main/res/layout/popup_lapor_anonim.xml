<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/card_putih">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lapor Kendaraan Tidak Ada"
            android:textSize="16sp"
            android:fontFamily="@font/poppinssemibold"
            android:textColor="#111827"
            android:layout_centerVertical="true"/>

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/baseline_close_24"
            android:padding="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tuliskan jenis, merek, atau model kendaraan Anda yang tidak ada di daftar pendaftaran."
        android:textSize="12sp"
        android:fontFamily="@font/poppins_regular"
        android:textColor="#6B7280"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Deskripsi"
        android:textSize="14sp"
        android:fontFamily="@font/poppinssemibold"
        android:textColor="#1F2937"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/etDeskripsiKendaraan"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/bg_input"
        android:gravity="top|start"
        android:hint="Contoh: Honda Vario 160 ABS tahun 2024..."
        android:padding="12dp"
        android:textColor="#111827"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_regular"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnKirimKendaraan"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:text="Kirim Laporan"
        android:textAllCaps="false"
        android:fontFamily="@font/poppinssemibold"
        android:backgroundTint="#DC2626"/>

</LinearLayout>
