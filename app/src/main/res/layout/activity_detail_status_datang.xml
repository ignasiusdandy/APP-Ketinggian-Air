<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB"
    tools:context=".DetailStatusDatangActivity">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shimmer_auto_start="true"
        app:shimmer_duration="1200"
        app:shimmer_base_alpha="0.85"
        app:shimmer_highlight_alpha="1"
        app:shimmer_direction="left_to_right">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- TOP BAR PLACEHOLDER (Now above map) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/shimmerTopBar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="48dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="6dp">

                        <View
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="#E5E7EB"
                            android:backgroundTint="#E5E7EB"
                            android:layout_marginEnd="8dp"/>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_weight="1"
                            android:background="#E5E7EB"
                            android:layout_marginEnd="40dp"/>

                        <View
                            android:layout_width="70dp"
                            android:layout_height="32dp"
                            android:background="#E5E7EB"
                            android:layout_marginEnd="8dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- MAP PLACEHOLDER -->
                <FrameLayout
                    android:id="@+id/shimmerMapContainer"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:background="#E5E7EB"
                    android:layout_below="@+id/shimmerTopBar"/>

                <!-- BOTTOM SHEET PLACEHOLDER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/shimmerMapContainer"
                    android:layout_marginTop="-40dp"
                    android:background="@drawable/bg_bottom_sheet"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:elevation="6dp">

                    <View
                        android:layout_width="40dp"
                        android:layout_height="4dp"
                        android:background="#E5E7EB"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="24dp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:background="#E5E7EB"
                        android:layout_marginBottom="20dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="115dp"
                        android:orientation="horizontal"
                        android:layout_marginBottom="20dp">
                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginRight="10dp"
                            android:background="#E5E7EB"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginLeft="10dp"
                            android:background="#E5E7EB"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:background="#E5E7EB"
                        android:layout_marginBottom="20dp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="230dp"
                        android:background="#E5E7EB"/>

                </LinearLayout>
            </RelativeLayout>
        </ScrollView>
    </com.facebook.shimmer.ShimmerFrameLayout>


    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:alpha="0">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F9FAFB">

            <!-- TOP BAR (Now above map) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/topBarDetail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="6dp">

                    <ImageView
                        android:id="@+id/btn_kembali"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/kembaliicon"
                        app:tint="#4B5563"
                        android:padding="12dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/tvTitleDetail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppinssemibold"
                        android:textSize="16sp"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="12sp"
                        app:autoSizeMaxTextSize="16sp"
                        app:autoSizeStepGranularity="1sp"
                        android:text="Jalan Datang ULM"
                        android:textColor="#111827"
                        android:layout_marginStart="8dp"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/bg_badge_aman"
                        android:gravity="center"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:id="@+id/bulatStatusDetail"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:src="@drawable/bg_icon_green_solid" />

                        <TextView
                            android:id="@+id/tvStatusDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/poppinssemibold"
                            android:textSize="12sp"
                            android:text="-"
                            android:textColor="#059669"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- MAP HEADER -->
            <FrameLayout
                android:id="@+id/mapContainer"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_below="@+id/topBarDetail">

                <org.osmdroid.views.MapView
                    android:id="@+id/mapDetailDatang"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/black"/>
            </FrameLayout>

            <!-- BOTTOM SHEET CONTENT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_below="@id/mapContainer"
                android:layout_marginTop="-40dp"
                android:background="@drawable/bg_bottom_sheet"
                android:paddingTop="20dp"
                android:paddingHorizontal="20dp"
                android:paddingBottom="40dp"
                android:elevation="8dp">

                <!-- DRAG HANDLE -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:background="#D1D5DB"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="24dp"/>

                <!-- REKOMENDASI -->
                <LinearLayout
                    android:id="@+id/bgRekomendasi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_hijau"
                    android:padding="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/iconRekomendasi"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/aman_icon" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textRekomendasi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinssemibold"
                            android:textColor="@color/black"
                            android:textSize="13sp"
                            android:text="Motor Honda Beat 120 Anda Aman untuk melintasi jalur ini"/>

                        <TextView
                            android:id="@+id/deskripsiRekomendasi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinsmedium"
                            android:textColor="@color/hijautulisanaman"
                            android:textSize="11sp"
                            android:text="Tetap hati-hati dan gunakan kecepatan rendah saat melintas"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- GAMBAR DARI MAPS -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/imageContainer"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <ImageView
                        android:id="@+id/image_status"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/jalan_datang"/>
                </com.google.android.material.card.MaterialCardView>

                <!-- DETAIL CARD KETINGGIAN & KECEPATAN -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeWidth="1dp"
                    app:strokeColor="#F3F4F6">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Ketinggian Air (Blue Card) -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:background="@drawable/bg_soft_blue_rounded"
                                    android:padding="8dp"
                                    android:layout_marginEnd="4dp">

                                <!-- Ketinggian Air Title with Icon -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginBottom="8dp">
                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:src="@drawable/ic_water_drop_custom"
                                        android:layout_marginEnd="6dp"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Ketinggian Air"
                                        android:textSize="12sp"
                                        android:textColor="#4B5563"
                                        android:fontFamily="@font/poppinsmedium"/>
                                </LinearLayout>

                                <!-- Tinggi text -->
                                <TextView
                                    android:id="@+id/tvTinggiDetail"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="- cm"
                                    android:textSize="22sp"
                                    android:textColor="#2563EB"
                                    android:fontFamily="@font/poppinssemibold"
                                    android:layout_marginBottom="4dp"/>

                                <!-- Desc text -->
                                <TextView
                                    android:id="@+id/tvKetTinggi"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Data Sensor"
                                    android:textSize="11sp"
                                    android:textColor="#6B7280"
                                    android:fontFamily="@font/poppins_regular"/>

                            </LinearLayout>

                            <!-- Tren Ketinggian (Purple Card) -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:background="@drawable/bg_soft_purple_rounded"
                                    android:padding="8dp"
                                    android:layout_marginStart="4dp">

                                <!-- Tren Title with Icon -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginBottom="8dp">
                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:src="@drawable/ic_chart_trend_custom"
                                        android:layout_marginEnd="6dp"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Tren Ketinggian"
                                        android:textSize="12sp"
                                        android:textColor="#4B5563"
                                        android:fontFamily="@font/poppinsmedium"/>
                                </LinearLayout>

                                <!-- Trend Status with Arrow -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginBottom="4dp">
                                    
                                    <TextView
                                        android:id="@+id/tvKecepatanDetail"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Stabil"
                                        android:textSize="22sp"
                                        android:textColor="#8B5CF6"
                                        android:fontFamily="@font/poppinssemibold"/>
                                        
                                    <ImageView
                                        android:id="@+id/arrowKecepatanDetail"
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_marginStart="4dp"
                                        android:src="@drawable/arrow_stabil"/>
                                </LinearLayout>

                                <!-- Desc text -->
                                <TextView
                                    android:id="@+id/tvKetTren"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tidak ada perubahan signifikan"
                                    android:textSize="11sp"
                                    android:textColor="#6B7280"
                                    android:fontFamily="@font/poppins_regular"/>

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Horizontal Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#F3F4F6"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="12dp"/>

                        <!-- Waktu Status -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Diperbarui:"
                                android:textSize="11sp"
                                android:textColor="#9CA3AF"
                                android:fontFamily="@font/poppinsmedium"/>
                            <TextView
                                android:id="@+id/tvWaktuDetail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="- WITA"
                                android:textSize="11sp"
                                android:textColor="#3B82F6"
                                android:fontFamily="@font/poppinsmedium"/>
                            
                            <Space
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"/>

                            <!-- Hidden items -->
                            <TextView
                                android:id="@+id/statusJam"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:visibility="gone"/>
                                
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- TABEL KENDARAAN -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeWidth="1dp"
                    app:strokeColor="#F3F4F6">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinssemibold"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:text="DAFTAR KENDARAAN &amp; STATUS"
                            android:layout_marginBottom="12dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:paddingBottom="8dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.1"
                                android:orientation="horizontal"
                                android:gravity="center">
                                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/plat_icon" android:layout_marginEnd="4dp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Plat" android:textSize="10sp" android:maxLines="1" android:textColor="@color/tulisanabu" android:fontFamily="@font/poppinsmedium"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.3"
                                android:orientation="horizontal"
                                android:gravity="center">
                                <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/kategori_icon" android:layout_marginEnd="4dp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kategori" android:textSize="10sp" android:maxLines="1" android:textColor="@color/tulisanabu" android:fontFamily="@font/poppinsmedium"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.4"
                                android:orientation="horizontal"
                                android:gravity="center">
                                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/model_icon" android:layout_marginEnd="4dp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Model" android:textSize="10sp" android:maxLines="1" android:textColor="@color/tulisanabu" android:fontFamily="@font/poppinsmedium"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.2"
                                android:orientation="horizontal"
                                android:gravity="center">
                                <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/statustabel_icon" android:layout_marginEnd="4dp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Status" android:textSize="10sp" android:maxLines="1" android:textColor="@color/tulisanabu" android:fontFamily="@font/poppinsmedium"/>
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E5E7EB"
                            android:layout_marginBottom="8dp"/>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvKendaraan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- GRAFIK -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeWidth="1dp"
                    app:strokeColor="#F3F4F6">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinssemibold"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:text="Grafik Perubahan 1 Jam Terakhir"
                            android:layout_marginBottom="12dp"/>

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/lineChart"
                            android:layout_width="match_parent"
                            android:layout_height="220dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </RelativeLayout>
    </ScrollView>

    <include
        android:id="@+id/layoutNoInternet"
        layout="@layout/layout_no_internet"/>

</FrameLayout>