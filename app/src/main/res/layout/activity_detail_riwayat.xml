<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F9FAFB">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/white"
        android:elevation="2dp">
        
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/kembaliicon"
            app:tint="#111827"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Detail Laporan"
            android:textColor="#111827"
            android:textSize="18sp"
            android:fontFamily="@font/poppinssemibold"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Shimmer Placeholder -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerDetailRiwayat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:shimmer_auto_start="true"
                app:shimmer_duration="1000">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_input"
                    android:padding="16dp">

                    <View android:layout_width="100dp" android:layout_height="12dp" android:background="#DDDDDD" />
                    <View android:layout_width="200dp" android:layout_height="20dp" android:background="#DDDDDD" android:layout_marginTop="8dp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E7EB" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" />

                    <View android:layout_width="80dp" android:layout_height="12dp" android:background="#DDDDDD" />
                    <View android:layout_width="150dp" android:layout_height="16dp" android:background="#DDDDDD" android:layout_marginTop="8dp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E7EB" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" />

                    <View android:layout_width="120dp" android:layout_height="12dp" android:background="#DDDDDD" />
                    <View android:layout_width="180dp" android:layout_height="16dp" android:background="#DDDDDD" android:layout_marginTop="8dp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E7EB" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" />

                    <View android:layout_width="60dp" android:layout_height="12dp" android:background="#DDDDDD" />
                    <View android:layout_width="100dp" android:layout_height="16dp" android:background="#DDDDDD" android:layout_marginTop="8dp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E7EB" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" />

                    <View android:layout_width="80dp" android:layout_height="12dp" android:background="#DDDDDD" />
                    <View android:layout_width="match_parent" android:layout_height="16dp" android:background="#DDDDDD" android:layout_marginTop="8dp" />
                    <View android:layout_width="150dp" android:layout_height="16dp" android:background="#DDDDDD" android:layout_marginTop="4dp" />

                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- Main Content Container -->
            <LinearLayout
                android:id="@+id/layoutMainContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_input"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipe Laporan"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:fontFamily="@font/poppinsmedium"/>

            <TextView
                android:id="@+id/tvDetailTipe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kondisi Jalan"
                android:textColor="#111827"
                android:textSize="16sp"
                android:fontFamily="@font/poppinssemibold"
                android:layout_marginTop="4dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tanggal"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:fontFamily="@font/poppinsmedium"/>

            <TextView
                android:id="@+id/tvDetailTanggal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="18 Jul 2026"
                android:textColor="#111827"
                android:textSize="14sp"
                android:fontFamily="@font/poppinsmedium"
                android:layout_marginTop="4dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"/>
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Pelapor"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:fontFamily="@font/poppinsmedium"/>

            <TextView
                android:id="@+id/tvDetailNamaPelapor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Memuat..."
                android:textColor="#111827"
                android:textSize="14sp"
                android:fontFamily="@font/poppinsmedium"
                android:layout_marginTop="4dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"/>
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:fontFamily="@font/poppinsmedium"/>

            <TextView
                android:id="@+id/tvDetailStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diproses"
                android:textColor="#F59E0B"
                android:textSize="14sp"
                android:fontFamily="@font/poppinssemibold"
                android:layout_marginTop="4dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"/>

            <ImageView
                android:id="@+id/ivDetailGambar"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="16dp"
                android:background="#F3F4F6"
                android:scaleType="centerCrop"
                android:visibility="gone"/>

            <!-- Layout Lokasi (Khusus Permintaan Lokasi) -->
            <LinearLayout
                android:id="@+id/layoutLokasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lokasi"
                    android:textColor="#6B7280"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppinsmedium"/>

                <TextView
                    android:id="@+id/tvDetailLokasi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Detail lokasi..."
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deskripsi"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:fontFamily="@font/poppinsmedium"/>

            <TextView
                android:id="@+id/tvDetailDeskripsi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Deskripsi laporan..."
                android:textColor="#111827"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginTop="4dp"/>

            <!-- Catatan Admin (Hidden by default) -->
            <LinearLayout
                android:id="@+id/layoutCatatan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E7EB"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Catatan Admin"
                    android:textColor="#6B7280"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppinsmedium"/>

                <TextView
                    android:id="@+id/tvDetailCatatan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pesan dari admin..."
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Form Edit Khusus Admin (Hidden by default) -->
            <LinearLayout
                android:id="@+id/layoutAdminEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E7EB"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ubah Status"
                    android:textColor="#6B7280"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppinsmedium"/>

                <Spinner
                    android:id="@+id/spinnerEditStatus"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input"
                    android:layout_marginTop="4dp"
                    android:paddingHorizontal="12dp"
                    android:popupBackground="@android:color/white"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ubah Catatan Admin"
                    android:textColor="#6B7280"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppinsmedium"
                    android:layout_marginTop="12dp"/>

                <EditText
                    android:id="@+id/etEditCatatan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="3"
                    android:gravity="top|start"
                    android:background="@drawable/bg_input"
                    android:hint="Masukkan catatan (opsional)"
                    android:padding="16dp"
                    android:layout_marginTop="4dp"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_regular"/>

                <TextView
                    android:id="@+id/btnSimpanPerubahan"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_btn_primary"
                    android:text="Simpan Perubahan"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppinssemibold"
                    android:gravity="center"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="40dp"/>
            </LinearLayout>

            </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
