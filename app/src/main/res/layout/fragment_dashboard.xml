<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===================== -->
    <!-- SHIMMER LOADING -->
    <!-- ===================== -->

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shimmer_auto_start="true"
        app:shimmer_duration="1500"
        app:shimmer_base_alpha="0.7"
        app:shimmer_highlight_alpha="1.0"
        app:shimmer_direction="left_to_right"
        app:shimmer_width_ratio="1.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white">

            <!-- HEADER PLACEHOLDER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="#E5E7EB">

                <View
                    android:layout_width="180dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="40dp"
                    android:background="#D1D5DB"/>

                <View
                    android:layout_width="120dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="16dp"
                    android:background="#D1D5DB"/>

            </LinearLayout>

            <!-- KENDARAAN -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="#D1D5DB"/>

                <View
                    android:layout_width="120dp"
                    android:layout_height="16dp"
                    android:layout_marginLeft="10dp"
                    android:background="#D1D5DB"/>

            </LinearLayout>

            <!-- CARD 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="15dp"
                android:background="#D1D5DB"
                android:orientation="vertical"
                android:padding="16dp">

                <View
                    android:layout_width="140dp"
                    android:layout_height="20dp"
                    android:background="#D1D5DB"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:layout_marginRight="10dp"
                        android:background="#D1D5DB"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="10dp"
                        android:background="#D1D5DB"/>

                </LinearLayout>

            </LinearLayout>

            <!-- CARD 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="15dp"
                android:background="#D1D5DB"
                android:orientation="vertical"
                android:padding="16dp">

                <View
                    android:layout_width="140dp"
                    android:layout_height="20dp"
                    android:background="#D1D5DB"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:layout_marginRight="10dp"
                        android:background="#D1D5DB"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="10dp"
                        android:background="#D1D5DB"/>

                </LinearLayout>

            </LinearLayout>

            <!-- CHART -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_margin="16dp"
                android:background="#D1D5DB"
                android:orientation="vertical"
                android:padding="16dp">

                <View
                    android:layout_width="180dp"
                    android:layout_height="20dp"
                    android:background="#D1D5DB"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="20dp"
                    android:background="#D1D5DB"/>

            </LinearLayout>

        </LinearLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>

    <!-- ===================== -->
    <!-- CONTENT ASLI -->
    <!-- ===================== -->

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/scrollView2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_gradient_blue"
            >


            <!-- ===================== -->
            <!-- TOP BAR: User Info    -->
            <!-- ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="56dp"
                android:paddingBottom="10dp"
                android:background="@android:color/transparent">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/selamatWaktu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selamat Pagi,"
                        android:textColor="#6B7280"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins_regular"/>
                    <TextView
                        android:id="@+id/haiNamaUser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nama User"
                        android:textColor="#111827"
                        android:textSize="18sp"
                        android:fontFamily="@font/poppinssemibold"
                        android:layout_marginTop="-2dp"/>
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnLogout"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/logout_icon"
                    app:tint="#2563EB"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- ===================== -->
            <!-- LOCATION SELECTOR     -->
            <!-- ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pilih Lokasi"
                    android:textColor="#4B5563"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppinsmedium"
                    android:layout_marginBottom="6dp"/>

                <LinearLayout
                    android:id="@+id/btnPilihLokasi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/card_putih"
                    android:elevation="2dp"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/maps_icon"
                        app:tint="#2563EB"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tvLokasiTerpilih"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Semua Wilayah"
                        android:textColor="#111827"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppinsmedium"/>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/down_arrow"
                        android:layout_gravity="center_vertical"
                        app:tint="#6B7280"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB"/>

            <!-- ===================== -->
            <!-- MOTOR UTAMA BAR       -->
            <!-- ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="0dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/kendaraan_icon"
                    app:tint="#4B5563"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kendaraan Utama: "
                    android:textColor="#6B7280"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_regular"/>

                <TextView
                    android:id="@+id/kendaraanUtama"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Honda Beat 150"
                    android:textColor="#111827"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppinssemibold"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <!-- ===================== -->
            <!-- INFO BANNER           -->
            <!-- ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_info_banner"
                android:padding="10dp">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/realtime_icon"
                    app:tint="#3B82F6"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:id="@+id/tvInfoBanner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Menampilkan data untuk semua area pantauan."
                    android:textColor="#1D4ED8"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_regular"/>
            </LinearLayout>

            <!-- Removed hidden views as they are now active above -->
            <!-- ===================== -->
            <!-- CARD: JALAN DATANG    -->
            <!-- ===================== -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStatusJalan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />

            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:visibility="gone">
                
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/ic_empty_water"
                    android:layout_marginBottom="8dp"/>
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Belum ada alat yang aktif"
                    android:textColor="#6B7280"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppinsmedium"/>
                    
                <TextView
                    android:layout_width="250dp"
                    android:layout_height="wrap_content"
                    android:text="Saat ini tidak ada sensor ketinggian air yang mengirimkan data ke sistem di wilayah ini."
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    android:textAlignment="center"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins_regular"/>
            </LinearLayout>






            <!-- Baris 2: Info Update + Keterangan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_putih"
                android:elevation="3dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="80dp"
                android:layout_marginTop="14dp"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Informasi Sensor"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppinssemibold"
                    android:layout_marginBottom="12dp"/>

                <!-- Info item: interval update -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/realtime_icon"
                        app:tint="#3B82F6"
                        android:layout_marginEnd="10dp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Interval Update Data"
                        android:textColor="#374151"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins_regular"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 Menit"
                        android:textColor="#2563EB"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppinsmedium"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F3F4F6"
                    android:layout_marginBottom="10dp"/>

                <!-- Info item: Status Aman -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/circle_green"
                        android:layout_marginEnd="10dp"
                        android:layout_marginStart="2dp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Indikator 1"
                        android:textColor="#374151"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins_regular"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aman"
                        android:textColor="#10B981"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppinsmedium"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F3F4F6"
                    android:layout_marginBottom="10dp"/>

                <!-- Info item: Status Waspada -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/circle_yellow"
                        android:layout_marginEnd="10dp"
                        android:layout_marginStart="2dp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Indikator 2"
                        android:textColor="#374151"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins_regular"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Waspada"
                        android:textColor="#F59E0B"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppinsmedium"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F3F4F6"
                    android:layout_marginBottom="10dp"/>

                <!-- Info item: Status Bahaya -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/circle_red"
                        android:layout_marginEnd="10dp"
                        android:layout_marginStart="2dp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Indikator 3"
                        android:textColor="#374151"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins_regular"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bahaya"
                        android:textColor="#EF4444"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppinsmedium"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Hidden: untuk kompatibilitas Java -->
            <TextView
                android:id="@+id/tvSatuanKiri"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"/>
            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/lineChart"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>