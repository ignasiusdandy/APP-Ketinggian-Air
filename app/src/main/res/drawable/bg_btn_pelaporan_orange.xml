<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40000000">
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#FF8F00"
                android:endColor="#FF5722"
                android:angle="135" />
