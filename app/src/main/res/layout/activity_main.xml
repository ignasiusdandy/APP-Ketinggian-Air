<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/scrollView"
        android:forceDarkAllowed="false">


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/blue6">

            <LinearLayout
                android:id="@+id/bg_validasi"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@color/backgroundvalidasisalah"
                android:gravity="center_vertical"
                android:layout_gravity="bottom"
                android:fitsSystemWindows="true"
                android:paddingTop="40dp"
                android:visibility="gone"
            >

                <ImageView
                    android:id="@+id/icon_validasi"
                    android:layout_marginLeft="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/kesalahan_icon" />
                <TextView
                    android:id="@+id/tvMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:textColor="@color/peringatan"
                    android:text="Email/password yang anda masukkan tidak sesuai"
                    android:textSize="14sp" />
            </LinearLayout>


            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/background_atas" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="58dp"
                android:layout_marginStart="16dp"
                android:text="Masuk Akun"
                android:fontFamily="@font/poppinssemibold"
                android:textColor="@color/white"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="230dp"
                android:layout_height="42dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="100dp"
                android:fontFamily="@font/poppinsmedium"
                android:text="Login untuk memantau kondisi jalan secara real time"
                android:textColor="#A1FFFFFF"
                android:textSize="12sp"
            />

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="192dp"
                android:adjustViewBounds="true"
                app:layout_constraintTop_toTopOf="@+id/imageView"
                app:srcCompat="@drawable/putih"
                tools:layout_editor_absoluteX="0dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="160dp">

                <TextView
                    android:id="@+id/textEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="70dp"
                    android:fontFamily="@font/poppinsmedium"
                    android:text="Email"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/div_email"
                    android:layout_marginTop="12dp"
                    android:layout_marginHorizontal="24dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical">


                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/email_icon"
                        android:layout_marginStart="16dp" />

                    <EditText
                        android:id="@+id/et_email"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:fontFamily="@font/poppinsmedium"
                        android:hint="Email Address"
                        android:inputType="textEmailAddress"
                        android:background="@null"
                        android:backgroundTint="@null"
                        android:paddingStart="12dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textColorHint="#BDBDBD"
                    />

                </LinearLayout>
                <TextView
                    android:id="@+id/wrongEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/peringatan"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="6dp"
                    android:text="Masukkan email"
                    android:textSize="14dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppinsmedium"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="28dp"
                    android:text="Kata Sandi"
                    android:textSize="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/layout_password"
                    android:background="@drawable/bg_input"
                    android:layout_marginTop="8dp"
                    android:layout_marginHorizontal="24dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/password_icon" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        app:boxBackgroundMode="none"
                        android:background="@null"
                        android:backgroundTint="@null"
                        app:endIconMode="password_toggle"
                        app:hintEnabled="false">

                        <EditText
                            android:id="@+id/et_password"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/poppinsmedium"
                            android:hint="Masukan Kata Sandi"
                            android:textSize="14sp"
                            android:inputType="textPassword"
                            android:paddingStart="12dp"
                            android:paddingEnd="16dp"
                            android:textColor="@color/black"
                            android:textColorHint="#BDBDBD" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/wrongPass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/peringatan"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="6dp"
                    android:text="Masukkan kata sandi"
                    android:textSize="14dp"
                    android:visibility="gone" />


                <LinearLayout
                    android:id="@+id/api_error_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_input"
                    android:backgroundTint="#FFF0F0"
                    android:padding="12dp"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/kesalahan_icon" />

                    <TextView
                        android:id="@+id/api_error_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:fontFamily="@font/poppinsmedium"
                        android:text="Email/Password salah!"
                        android:textColor="@color/peringatan"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginRight="20dp"
                    android:backgroundTint="@color/blue6"
                    android:fontFamily="@font/poppinsmedium"
                    android:text="Masuk Sekarang"
                    android:textAllCaps="false"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="24dp">

                    <TextView
                        android:id="@+id/textView7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppinsmedium"
                        android:text="Belum mempunyai akun?" />

                    <TextView
                        android:id="@+id/textView8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/poppinsmedium"
                        android:text="Daftar Sekarang"
                        android:textColor="@color/blue9" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

    </ScrollView>

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

</RelativeLayout>